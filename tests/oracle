#!/bin/sh
########################################################################
#
# The oracle: the same program under the optimizer, clang -O2, and
# under the literal machine, rcc, on the corpus of divergence
# programs.  Where the two differ is the output of the experiment.
#
# The run checks one target, x86-64 or aarch64, given by --target;
# the default is this machine's own, from uname -m.  Each target has
# its pins in a directory of its own, tests/corpus/<target>, and a
# target without one is an error.  The programs and the table of
# statuses are shared by every target.
#
# Each program tests/corpus/<name>.c is written by
# ./rcc -target <target> -S, and the assembly is diffed against the
# pin, tests/corpus/<target>/<name>.s.  ./rcc -target <target> -c
# assembles it into an object, to prove that it assembles.
#
# On this machine's own target the program is also built by ./rcc,
# which has no optimization levels, and by clang -O2, and each build
# is run with no arguments and no standard input.  The two exit
# statuses are compared with the program's row in
# tests/corpus/expected.  A row passes when both statuses match the
# table, the object assembled and the pin matches the assembly; a
# program without a row or without a pin fails.
#
# A target's generator is written in slices, and a program may use a
# construct whose slice is not in the tree yet.  rcc then stops in c1
# with exit status 3 and the message "c1: not yet: ...".  A program
# that has no pin for the target and stops so is not built or run: it
# shows "not yet" in its row, and is neither passed nor failed.  The
# summary counts it apart, and it does not make the exit status 1.  A
# program with a pin that stops so fails, as any program with a pin
# that did not build.
#
# On another machine's target nothing is built to run: the rcc and
# clang columns show "-", a row passes when the object assembled and
# the pin matches the assembly, and the summary says that the
# programs were not run.
#
# A program may hang by promise, so each run has a time limit of 10
# seconds when timeout(1) is on the path.  A run it stops, status 124,
# shows as "timeout", and a row that expects "timeout" passes on it.
# Without timeout the script says so once and runs without a limit.
#
# The script prints a table, one row per program, and a summary, and
# exits 0 when every row passed or is not yet, 1 otherwise.  It runs
# from the tree root with ./rcc built, as make test runs it.  The
# programs, their assembly and objects and the log of every command
# stay in build/oracle/<target>, so that runs for two targets do not
# overwrite each other; each command's output in the log follows a
# "### <command>:" line and ends with a "### status <n>" line.
#
# tests/corpus/expected holds one line per program: its name, the
# exit status of the rcc build and that of the clang build, separated
# by spaces.  A status is a number, or "timeout" for a run stopped at
# the time limit.  A # starts a comment.
#
########################################################################
#
# USAGE:
#
#     tests/oracle [ --target <name> ] [ --pin ] [ --help ]
#
# OPTIONS:
#
#     --target <name>
#         Checks the target <name>, x86-64 or aarch64, against its
#         pins in tests/corpus/<name>.  Without it the target is this
#         machine's own, and a machine rcc has no target for is an
#         error.  A target without a pin directory is an error, exit
#         status 2.
#
#     --pin
#         Adopts the run for the target.  Copies the assembly of
#         every program over its pin, and, on this machine's own
#         target, rewrites the status columns of tests/corpus/expected
#         from the measured statuses, printing what changed in each.
#         On another machine's target nothing was measured, and
#         tests/corpus/expected is left alone.  A program that did not
#         build, or wrote no assembly, is left as it was.  A program
#         that is not yet is left without a pin, keeps its row, and is
#         not counted as unadopted.  Exits 0 when every other program
#         was adopted, 1 otherwise.  It is how a new program enters
#         the corpus, after a human has read its assembly and its
#         statuses.  A target's first pins need its directory made
#         first.
#
#     --help
#         Prints the usage and exits.
#
# EXAMPLES:
#
#     tests/oracle
#
#     Builds, runs and diffs every program in the corpus for this
#     machine's own target, prints the table and the summary, and
#     keeps the log in build/oracle/<target>/log.
#
#     tests/oracle --target x86-64
#
#     Writes, assembles and diffs every program for x86-64, on any
#     machine, and runs the programs only on an x86-64 machine; the
#     log is build/oracle/x86-64/log.
#
#     tests/oracle --pin
#
#     The same run as the first, then the pins and
#     tests/corpus/expected are made to match it.
#
########################################################################

##########
# global constants

# the name of the script, in diagnostics
myname=${0##*/}

# the corpus and the table of the statuses each program should give
corpus=tests/corpus
expected=$corpus/expected

# the shown status of a program that did not build, and of one that
# was not run
unbuilt=unbuilt
unrun=-

# the exit status of rcc and the start of its message when c1 meets a
# construct whose slice is not in the tree yet
not_yet_status=3
not_yet_message='c1: not yet:'

# the seconds a program may run, the status timeout(1) gives when it
# stops one, and the status shown for it
time_limit=10
timeout_status=124
timed_out=timeout

# byte order for the sorted corpus, and diagnostics in one language
LC_ALL=C
export LC_ALL

##########
# global variables

# with --pin, the run is adopted as the pins and the expected statuses
pin=0

# the target the run checks, from --target or this machine's own, and
# the directory of its pins
target=
pins=

# this machine's own target, empty when rcc has none for it
native=

# 1 when the target is this machine's own and the programs are run
run=0

# the work directory of the target, kept between runs and removed by
# make clean; set once the target is known
workdir=

# the log of every command, the output of the last command, kept apart
# for a look at its message, and the statuses each program gave
log=
output=
measured=

# the command line, for the log
command_line="$0 $*"

# 1 when timeout(1) is on the path and each run has the time limit
limited=0

# the rows of the table, the rows that passed, and the rows that are
# not yet with their programs' names, space separated
programs=0
passed=0
waiting=0
waiting_names=


##########
# usage(): prints the usage
usage()
{
    echo "usage: $0 [ --target <name> ] [ --pin ] [ --help ]"
    echo
    echo "    --target  check the target <name>, x86-64 or aarch64; this machine's by default"
    echo "    --pin     adopt the run: rewrite the pins and the expected statuses"
    echo "    --help    print this usage"
}


##########
# machine_target(): prints the target of this machine, from uname -m;
# reports 1 and prints nothing when rcc has no target for it
machine_target()
{
    machine=$(uname -m)

    case "$machine" in
        x86_64)  # the machine of the x86-64 target
            echo x86-64
            ;;

        aarch64)  # the machine of the aarch64 target
            echo aarch64
            ;;

        *)  # a machine rcc writes no code for
            return 1
            ;;
    esac
}


##########
# check_target(): reports 0 when the target has a pin directory under
# the corpus, and says what is missing otherwise
check_target()
{
    name=$1

    case "$name" in
        "" | . | .. | */*)  # not the name of a directory of the corpus
            echo "$myname: '$name' is not a target" >&2
            return 1
            ;;
    esac

    if [ ! -d "$corpus/$name" ]; then
        echo "$myname: no pins for $name; no directory $corpus/$name" >&2
        return 1
    fi

    return 0
}


##########
# check_tree(): reports 0 when the script runs from the tree root with
# rcc built, and says what is missing otherwise
check_tree()
{
    if [ ! -d "$corpus" ]; then
        echo "$myname: no $corpus here; run from the tree root" >&2
        return 1
    fi

    if [ ! -x ./rcc ]; then
        echo "$myname: no ./rcc; run make first" >&2
        return 1
    fi

    return 0
}


##########
# find_timeout(): sets limited to 1 when timeout(1) is on the path, and
# says once that the runs have no time limit otherwise
find_timeout()
{
    if command -v timeout > /dev/null 2>&1; then
        limited=1
    else
        echo "$myname: no timeout on the path; programs run without a limit" >&2
    fi
}


##########
# logged(): runs a command with its standard output and standard error
# appended to the log after a "### <command>:" line, and its status
# after the output; the output is also kept in the file output until
# the next command; reports the command's status as its own
logged()
{
    echo "### $*:" >> "$log"

    "$@" > "$output" 2>&1
    status=$?

    cat "$output" >> "$log"
    echo "### status $status" >> "$log"
    echo >> "$log"

    return $status
}


##########
# measure(): builds a program with the compiler command that follows
# the source and the executable, then runs it with no arguments and no
# standard input, under the time limit when there is one; prints the
# program's exit status, "timeout" when the limit stopped it, or
# "unbuilt" when the build failed
measure()
{
    source=$1
    exe=$2
    shift 2

    if ! logged "$@" -o "$exe" "$source"; then
        echo "$unbuilt"
        return 1
    fi

    if [ "$limited" -eq 0 ]; then
        logged "$exe" < /dev/null
        echo $?
        return 0
    fi

    logged timeout "$time_limit" "$exe" < /dev/null
    status=$?

    if [ "$status" -eq "$timeout_status" ]; then
        echo "$timed_out"
    else
        echo "$status"
    fi
}


##########
# not_yet(): writes the program's assembly for the target with rcc -S
# and reports 0 when rcc stopped in c1 at a construct whose slice is
# not in the tree yet, 1 when it wrote the text or stopped otherwise
not_yet()
{
    name=$1

    logged ./rcc -target "$target" -S -o "$workdir/$name.s" \
        "$corpus/$name.c"
    written=$?

    [ "$written" -eq "$not_yet_status" ] &&
        grep -q "$not_yet_message" "$output"
}


##########
# check_pin(): writes the program's assembly for the target with
# rcc -S and diffs it against the target's pin; prints "pin ok",
# "pin differs" or "no pin"
check_pin()
{
    name=$1

    pin_file=$pins/$name.s
    asm_file=$workdir/$name.s

    # a failure leaves no text, and the diff below reports the difference
    logged ./rcc -target "$target" -S -o "$asm_file" "$corpus/$name.c"

    if [ ! -e "$pin_file" ]; then
        echo "no pin"
    elif logged diff -u "$pin_file" "$asm_file"; then
        echo "pin ok"
    else
        echo "pin differs"
    fi
}


##########
# assemble(): writes the program's object for the target with rcc -c,
# which hands clang the target, to prove that the assembly assembles;
# reports rcc's status as its own
assemble()
{
    name=$1

    logged ./rcc -target "$target" -c -o "$workdir/$name.o" \
        "$corpus/$name.c"
}


##########
# expected_of(): prints the two expected statuses of a program, space
# separated, or nothing when expected has no row for it
expected_of()
{
    name=$1

    if [ ! -r "$expected" ]; then
        return 0
    fi

    awk -v name="$name" '
        { sub(/#.*/, "") }
        $1 == name { print $2, $3; exit }
    ' "$expected"
}


##########
# print_row(): prints one row of the table
print_row()
{
    name=$1
    rcc_status=$2
    clang_status=$3
    pin_state=$4
    verdict=$5

    printf '%-24s %-8s %-8s %-12s %s\n' \
        "$name" "$rcc_status" "$clang_status" "$pin_state" "$verdict"
}


##########
# check_program(): on this machine's own target, builds and runs one
# program both ways and records its statuses; on any target, diffs its
# assembly against the pin and assembles it; prints its row; reports
# 0 when the row passed, 1 when it failed, and 2 when it is not yet:
# the program has no pin and c1 does not handle it yet
check_program()
{
    name=$1

    source=$corpus/$name.c
    stem=$workdir/$name

    # an output left by an earlier run must not stand in for this one's
    rm -f "$stem.rcc" "$stem.clang" "$stem.s" "$stem.o"

    # a program that waits for its slice is neither built nor run, and
    # its row in expected stays as it is
    if [ ! -e "$pins/$name.s" ] && not_yet "$name"; then
        if [ "$run" -ne 0 ]; then
            echo "$name $unrun $unrun" >> "$measured"
        fi

        print_row "$name" "$unrun" "$unrun" "no pin" "not yet"
        return 2
    fi

    if [ "$run" -ne 0 ]; then
        rcc_status=$(measure "$source" "$stem.rcc" ./rcc -target "$target")
        clang_status=$(measure "$source" "$stem.clang" clang -O2)

        echo "$name $rcc_status $clang_status" >> "$measured"
    else
        rcc_status=-
        clang_status=-
    fi

    pin_state=$(check_pin "$name")

    assembled=1
    assemble "$name" || assembled=0

    want=$(expected_of "$name")

    if [ "$run" -ne 0 ] && [ -z "$want" ]; then
        verdict="FAIL (no row in $expected)"
    elif [ "$run" -ne 0 ] && [ "$want" != "$rcc_status $clang_status" ]; then
        verdict="FAIL (expected $want)"
    elif [ "$assembled" -eq 0 ]; then
        verdict="FAIL (did not assemble)"
    elif [ "$pin_state" != "pin ok" ]; then
        verdict=FAIL
    else
        verdict=pass
    fi

    print_row "$name" "$rcc_status" "$clang_status" "$pin_state" "$verdict"

    [ "$verdict" = pass ]
}


##########
# is_waiting(): reports 0 when the program's row in this run is not
# yet, 1 otherwise
is_waiting()
{
    name=$1

    case " $waiting_names " in
        *" $name "*)  # among the rows not yet
            return 0
            ;;

        *)  # a row that passed or failed
            return 1
            ;;
    esac
}


##########
# adopt_pins(): copies the assembly of the run over the target's pin
# of every program, printing each pin it made or changed, and leaves a
# program that is not yet without one; reports 1 when another program
# wrote no text or a pin could not be written, 0 otherwise
adopt_pins()
{
    result=0

    for source in "$corpus"/*.c; do
        [ -e "$source" ] || continue

        name=${source##*/}
        name=${name%.c}

        pin_file=$pins/$name.s
        asm_file=$workdir/$name.s

        if is_waiting "$name"; then
            echo "$name: not yet, left without a pin"
        elif [ ! -e "$asm_file" ]; then
            echo "$name: no text, pin left as it was"
            result=1
        elif [ ! -e "$pin_file" ]; then
            cp "$asm_file" "$pin_file" && echo "pinned $pin_file (new)" ||
                result=1
        elif ! cmp -s "$pin_file" "$asm_file"; then
            cp "$asm_file" "$pin_file" && echo "pinned $pin_file (changed)" ||
                result=1
        fi
    done

    return $result
}


##########
# adopt_expected(): rewrites the status columns of the expected table
# from the measured statuses and prints the change as a diff; comments
# and the order of the rows stay, a program new to the table is
# appended, a row whose program left the corpus goes, and a program
# that did not build or was not run keeps its row; reports 1 when a
# program that should have run could not be adopted or the table could
# not be written, 0 otherwise
adopt_expected()
{
    result=0
    new=$workdir/expected

    if grep -q " $unbuilt" "$measured"; then
        echo "$expected: a program that did not build keeps its row"
        result=1
    fi

    # the table may not exist yet; an empty one gains every row
    if [ ! -e "$expected" ]; then
        : > "$expected" || return 1
    fi

    awk -v unbuilt="$unbuilt" -v unrun="$unrun" '
        FILENAME == ARGV[1] {
            order[++n] = $1
            known[$1] = 1
            if ($2 != unbuilt && $3 != unbuilt && $2 != unrun && $3 != unrun)
                row[$1] = $1 " " $2 " " $3
            next
        }
        {
            c = index($0, "#")
            data = c ? substr($0, 1, c - 1) : $0
            comment = c ? " " substr($0, c) : ""
        }
        split(data, f) == 0 { print; next }
        !(f[1] in known) { next }
        {
            seen[f[1]] = 1
            if (f[1] in row)
                print row[f[1]] comment
            else
                print
        }
        END {
            for (i = 1; i <= n; i++)
                if (!(order[i] in seen) && (order[i] in row))
                    print row[order[i]]
        }
    ' "$measured" "$expected" > "$new" || return 1

    if cmp -s "$expected" "$new"; then
        echo "$expected unchanged"
    else
        diff -u "$expected" "$new"
        cp "$new" "$expected" || return 1
    fi

    return $result
}


##########
# main body of script

# process command line options
while [ $# -gt 0 ]; do
    case "$1" in
        --target)  # check the target named next, not this machine's own
            if [ $# -lt 2 ]; then
                usage >&2
                exit 2
            fi
            target=$2
            shift
            ;;

        --pin)  # adopt the run as the pins and the expected statuses
            pin=1
            ;;

        --help)  # print the usage and stop
            usage
            exit 0
            ;;

        *)  # anything else is a usage error
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# without the tree root and a built rcc there is nothing to run
check_tree || exit 2

# this machine's own target is the default, and the one whose programs
# run; a machine rcc has no target for has no default
native=$(machine_target)

if [ -z "$target" ] && [ -z "$native" ]; then
    echo "$myname: rcc has no target for this machine, $(uname -m);" \
        "name one with --target" >&2
    exit 2
fi

if [ -z "$target" ]; then
    target=$native
fi

# a target without pins has nothing to be checked against
check_target "$target" || exit 2

pins=$corpus/$target
workdir=build/oracle/$target
log=$workdir/log
output=$workdir/output
measured=$workdir/measured

if [ "$target" = "$native" ]; then
    run=1
fi

# without timeout(1) the runs go on, unlimited; on another machine's
# target nothing runs
if [ "$run" -ne 0 ]; then
    find_timeout
fi

# the work directory is kept; the log and the measurements start over
if ! mkdir -p "$workdir" || ! : > "$log" || ! : > "$measured"; then
    echo "$myname: cannot write in $workdir" >&2
    exit 2
fi

echo "### running $command_line" >> "$log"
echo >> "$log"

print_row program rcc clang pin result

# one row per program in sorted order; a failed row does not stop the run
for source in "$corpus"/*.c; do
    [ -e "$source" ] || continue

    name=${source##*/}
    name=${name%.c}

    programs=$((programs + 1))
    check_program "$name"

    case $? in
        0)  # the row passed
            passed=$((passed + 1))
            ;;

        2)  # the row is not yet, and counted apart
            waiting=$((waiting + 1))
            waiting_names="$waiting_names $name"
            ;;
    esac
done

if [ "$programs" -eq 0 ]; then
    echo "$myname: no programs in $corpus" >&2
    exit 1
fi

# the rows that are not yet are neither passed nor failed
checked=$((programs - waiting))

counts="$passed of $checked passed"
if [ "$waiting" -ne 0 ]; then
    counts="$counts, $waiting not yet"
fi

echo
if [ "$run" -ne 0 ]; then
    echo "$counts; the log is $log"
else
    echo "$counts;" \
        "the programs were not run on another machine's target;" \
        "the log is $log"
fi

# with --pin, the exit status is the adoption's, not the run's; on
# another machine's target nothing was measured, and the table stays
if [ "$pin" -ne 0 ]; then
    echo
    adopt_pins
    pins_status=$?

    if [ "$run" -ne 0 ]; then
        adopt_expected
        expected_status=$?
    else
        echo "$expected left alone: the programs were not run"
        expected_status=0
    fi

    [ "$pins_status" -eq 0 ] && [ "$expected_status" -eq 0 ]
    exit $?
fi

[ "$passed" -eq "$checked" ]
exit $?
