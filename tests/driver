#!/bin/sh
########################################################################
#
# The driver: rcc's command line as a user gives it, checked for what
# rcc leaves behind, its exit status, its standard output and the
# files it writes.  The other scripts run rcc with the options they
# need, and none of them checks where the output goes, by the rules
# of docs/shape.md chapter 8.
#
# Each case runs ./rcc on a small program the script writes:
#
#     assembly    -S -o - writes the assembly to the standard output,
#                 the text -S -o <file> writes, and exits 0
#     object      -c -o - is a usage error: exit status 2, the usage
#                 line on standard error, nothing on standard output
#     link        -o - for a link is the same usage error
#     dialect     -S runs clang -E with -std=gnu17, as a clang earlier
#                 on PATH, which the script writes, records it
#
# No case may leave a file named -.  The runs are made in the work
# directory, so a file rcc writes by mistake lands there and not in
# the tree.
#
# The script prints a line per case, its name and "pass" or what
# differed, and a summary.  It exits 0 when every case passed, 1
# otherwise.  It runs from the tree root with ./rcc built, as make
# test runs it.  The program, the outputs and the log of every command
# stay in build/driver; each command's standard output and standard
# error in the log follow a "### <command>:" line and end with a
# "### status <n>" line.
#
########################################################################
#
# USAGE:
#
#     tests/driver [ --help ]
#
# OPTIONS:
#
#     --help
#         Prints the usage and exits.
#
# EXAMPLES:
#
#     tests/driver
#
#     Runs every case, prints a line for each and the summary, and
#     keeps the log in build/driver/log.
#
########################################################################

##########
# global constants

# the name of the script, in diagnostics
myname=${0##*/}

# the work directory, kept between runs and removed by make clean
workdir=build/driver

# the cases, in the order they run
cases="assembly object link dialect"

# the program the cases compile, and the assembly -S -o writes for it,
# both in the work directory
source=driver.c
assembly=driver.s

# the exit status of a usage error, and the start of the usage line
usage_status=2
usage_line='usage: rcc'

# the flag that names the dialect of clang -E; the directory of the
# clang that records its arguments, and the file it records them in,
# both in the work directory
dialect_flag=-std=gnu17
shims=bin
arguments=clang-arguments

# diagnostics in one language
LC_ALL=C
export LC_ALL

##########
# global variables

# ./rcc by its full path, since the runs are made in the work directory
rcc=

# the log of every command, and the last command's standard output and
# standard error
log=$workdir/log
stdout=$workdir/stdout
stderr=$workdir/stderr

# the command line, for the log
command_line="$0 $*"

# the cases run, and the cases that passed
count=0
passed=0


##########
# usage(): prints the usage
usage()
{
    echo "usage: $0 [ --help ]"
    echo
    echo "    --help    print this usage"
}


##########
# check_tree(): reports 0 when the script runs from the tree root with
# rcc built, and says what is missing otherwise
check_tree()
{
    if [ ! -f tests/driver ]; then
        echo "$myname: no tests/driver here; run from the tree root" >&2
        return 1
    fi

    if [ ! -x ./rcc ]; then
        echo "$myname: no ./rcc; run make first" >&2
        return 1
    fi

    return 0
}


##########
# logged(): runs a command in the work directory with its standard
# output and standard error kept in the files stdout and stderr until
# the next command, and appended to the log after a "### <command>:"
# line, with its status after them; reports the command's status as
# its own
logged()
{
    echo "### $*:" >> "$log"

    ( cd "$workdir" && "$@" ) > "$stdout" 2> "$stderr"
    status=$?

    cat "$stdout" "$stderr" >> "$log"
    echo "### status $status" >> "$log"
    echo >> "$log"

    return $status
}


##########
# check_assembly(): -S -o - writes to the standard output the text that
# -S -o <file> writes, and exits 0; prints what differed, or nothing
check_assembly()
{
    if ! logged "$rcc" -S -o "$assembly" "$source"; then
        echo "not run: -S -o $assembly failed"
        return
    fi

    logged "$rcc" -S -o - "$source"
    status=$?

    if [ "$status" -ne 0 ]; then
        echo "exit status $status, not 0"
    elif ! cmp -s "$stdout" "$workdir/$assembly"; then
        echo "the standard output is not the text of -S -o $assembly"
    fi
}


##########
# check_usage(): the options that follow, with the program, make a
# usage error: exit status 2, the usage line on standard error,
# nothing on standard output; prints what differed, or nothing
check_usage()
{
    logged "$rcc" "$@" "$source"
    status=$?

    if [ "$status" -ne "$usage_status" ]; then
        echo "exit status $status, not $usage_status"
    elif [ -s "$stdout" ]; then
        echo "wrote on the standard output"
    elif ! grep -q "^$usage_line" "$stderr"; then
        echo "no usage line on the standard error"
    fi
}


##########
# check_dialect(): -S runs clang -E with the dialect's flag; a clang
# put before the real one on PATH appends its arguments to a file and
# runs the real one; prints what differed, or nothing
check_dialect()
{
    real=$(command -v clang)
    if [ -z "$real" ]; then
        echo "not run: no clang on PATH"
        return
    fi

    if ! mkdir -p "$workdir/$shims" || ! : > "$workdir/$arguments" ||
       ! printf '#!/bin/sh\necho "$*" >> %s\nexec %s "$@"\n' \
            "$(pwd)/$workdir/$arguments" "$real" > "$workdir/$shims/clang" ||
       ! chmod +x "$workdir/$shims/clang"; then
        echo "not run: cannot write the recording clang"
        return
    fi

    if ! logged env PATH="$(pwd)/$workdir/$shims:$PATH" \
            "$rcc" -S -o "$assembly" "$source"; then
        echo "not run: -S -o $assembly failed"
        return
    fi

    cat "$workdir/$arguments" >> "$log"
    if ! grep -e '-E ' "$workdir/$arguments" |
         grep -q -e "$dialect_flag"; then
        echo "clang -E ran without $dialect_flag"
    fi
}


##########
# check_case(): runs one case and prints its line, "pass" or what
# differed; reports 0 when the case passed, 1 otherwise
check_case()
{
    name=$1

    # a file left by an earlier case must not stand for this one's
    rm -f "$workdir/-" "$workdir/$assembly"

    case "$name" in
        assembly)  # the assembly on the standard output
            failure=$(check_assembly)
            ;;

        object)  # an object is no text
            failure=$(check_usage -c -o -)
            ;;

        link)  # nor is an executable
            failure=$(check_usage -o -)
            ;;

        dialect)  # the preprocessor's dialect is named
            failure=$(check_dialect)
            ;;
    esac

    if [ -z "$failure" ] && [ -e "$workdir/-" ]; then
        failure="left a file named -"
    fi

    if [ -n "$failure" ]; then
        printf '%-12s %s\n' "$name" "$failure"
        return 1
    fi

    printf '%-12s %s\n' "$name" pass
}


##########
# main body of script

# process command line options
while [ $# -gt 0 ]; do
    case "$1" in
        --help)  # print the usage and stop
            usage
            exit 0
            ;;

        *)  # any other argument is a usage error
            usage >&2
            exit 2
            ;;
    esac
    shift
done

# without the tree root and a built rcc there is nothing to run
check_tree || exit 2

# rcc killed by a signal leaves no core file: the log has its status,
# and a core would land in the work directory, or where core_pattern
# says, on every run
ulimit -c 0

rcc=$(pwd)/rcc

# the work directory is kept; the log starts over, and the program is
# written afresh
if ! mkdir -p "$workdir" || ! : > "$log" ||
   ! printf 'int main(void)\n{\n    return 0;\n}\n' \
        > "$workdir/$source"; then
    echo "$myname: cannot write in $workdir" >&2
    exit 2
fi

echo "### running $command_line" >> "$log"
echo >> "$log"

# one line per case; a failed case does not stop the run
for name in $cases; do
    count=$((count + 1))
    if check_case "$name"; then
        passed=$((passed + 1))
    fi
done

echo
echo "$passed of $count cases passed; the log is $log"

[ "$passed" -eq "$count" ]
exit $?
